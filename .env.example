# ==============================================================================
# CivicLens Backend Environment Configuration Template
# Copy this file to .env.local and populate before starting the application.
# All variables are strictly server-side (no NEXT_PUBLIC_ exposure).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DEPLOYMENT SETTINGS
# ------------------------------------------------------------------------------
# Canonical deployment domain (used for OAuth callbacks, sitemaps, and share links)
APP_URL="http://localhost:3000"

# Default municipal fallbacks (used when client disables browser GPS)
DEFAULT_LAT="28.6139"
DEFAULT_LNG="77.2090"
DEFAULT_WARD="Ward 32"
DEFAULT_CITY="New Delhi"

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MongoDB Atlas / Local)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas M0 or local MongoDB instance, e.g., mongodb://localhost:27017/civiclens)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/civiclens?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ACCESS CONTROL (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Session encryption secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-here"
AUTH_URL="http://localhost:3000"

# Google Cloud Identity OAuth 2.0 Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Comma-separated list of municipal emails granted "ADMIN" triage access
ADMIN_EMAILS="admin@civiclens.org,engineer@municipal.gov"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA & COMPUTATIONAL EDGE ENGINE
# ------------------------------------------------------------------------------
# Cloudinary account details used by server actions for generating signed upload tokens
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="civiclens_signed_preset"

# ------------------------------------------------------------------------------
# 5. OPENROUTER VISION AI (Privacy Redaction & Auto-Blur Engine)
# ------------------------------------------------------------------------------
# API key used for automated detection of faces, license plates, and house numbers
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
